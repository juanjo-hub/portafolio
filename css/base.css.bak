/* ============================
   BASE / RESET
============================ */

html,
body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
}

body {
    overflow: hidden;
    font-family: "Cinzel", serif;
}


/* ============================
   ESTRUCTURA PRINCIPAL
============================ */

main {
    display: flex;

    width: 100vw;
    height: 100vh;

    overflow: hidden;
}

.col {
    height: 100%;
    background: #731803;
}


/* ============================
   BOTÓN MOSTRAR/OCULTAR PANEL
   Pestaña adherida al borde
   izquierdo (mismo lado por el
   que se oculta el panel).
   Oculto en escritorio, solo se
   muestra en los breakpoints
   móvil/tablet definidos abajo.
============================ */

.boton-alternar-panel {
    display: none;

    position: fixed;
    top: 1rem;
    left: 1rem;
    z-index: 200;

    width: 44px;
    height: 44px;

    align-items: center;
    justify-content: center;

    background: rgba(0, 0, 0, .65);
    border: 1px solid rgba(244, 227, 178, .4);
    border-radius: 50%;

    box-shadow: 0 2px 8px rgba(0, 0, 0, .5);

    color: #f4e3b2;
    font-size: 1.1rem;

    cursor: pointer;

    transition: background .2s ease, color .2s ease;
}

.boton-alternar-panel i {
    transition: transform .3s ease;
}

.boton-alternar-panel:hover,
.boton-alternar-panel:focus-visible {
    background: rgba(0, 0, 0, .85);
    color: #ffe9a8;
}

.boton-alternar-panel:focus-visible {
    outline: 2px solid #ffe9a8;
    outline-offset: 2px;
}


/* ============================
   COLUMNA IZQUIERDA
   Landing page: el panel es fijo
   en escritorio (siempre visible,
   sin estados) y cajón oculto en
   móvil/tablet (ver responsive).
============================ */

.izquierda {
    width: 20vw;

    position: relative;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    gap: 2rem;

    background:
        url("../imagenes/fondo.webp");

    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;

    overflow: hidden;
}

/*
 * Capa oscura para garantizar contraste del texto
 * sin depender del brillo de la imagen de fondo.
 */
.izquierda::before {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 0;

    background:
        linear-gradient(
            180deg,
            rgba(0, 0, 0, .5),
            rgba(0, 0, 0, .65)
        );
}

.izquierda > * {
    position: relative;
    z-index: 1;
}


/* ============================
   LOGO
============================ */

.logo-boton {
    background: none;
    border: none;
    padding: 0;
    margin: 0;

    cursor: pointer;

    border-radius: 8px;
}

.logo-boton:focus-visible {
    outline: 2px solid #ffe9a8;
    outline-offset: 3px;
}

.logo {
    display: block;

    width: 120px;
    height: auto;
}

.logo-boton:hover .logo {
    box-shadow:
        0 2px 6px #000;
}


/* ============================
   MENÚ
============================ */

.menu {
    display: flex;
    flex-direction: column;

    gap: 1.5rem;

    text-align: center;
}

.menu a {
    position: relative;

    color: #f4e3b2;
    font-weight: 600;

    letter-spacing: 1px;

    text-decoration: none;

    text-shadow:
        0 2px 3px rgba(0, 0, 0, 1),
        0 4px 10px rgba(0, 0, 0, 1),
        0 0 20px rgba(0, 0, 0, .6);

    transition: color 0.2s ease;

    font-size: 1.3rem;

    cursor: pointer;
}

.menu a:hover {
    color: #ffe9a8;
}


/* Sección actualmente visible al hacer scroll */
.menu a.activo {
    color: #ffe9a8;
}


/* ============================
   INFO / REDES / FOOTER
============================ */

.info {
    margin-top: 2rem;

    color: #fff;

    font-size: 1rem;
}

.redes {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 1.3rem;

    margin-bottom: .9rem;
}

.redes a {
    display: flex;
    align-items: center;
    justify-content: center;

    text-decoration: none;

    color: #f4e3b2;
    font-size: 1.5rem;

    text-shadow:
        0 2px 4px rgba(0, 0, 0, 1),
        0 0 14px rgba(0, 0, 0, .6);

    transition: color .2s ease, transform .2s ease;
}

.redes a:hover {
    color: #ffe9a8;
    transform: translateY(-2px);
}

.footer-copy {
    text-shadow:
        0 2px 3px rgba(0, 0, 0, 1),
        0 0 12px rgba(0, 0, 0, .6);
}


/* ============================
   COLUMNA DERECHA
============================ */

.derecha {
    flex: 1;

    position: relative;

    height: 100vh;

    /*
     * IMPORTANTE:
     * la izquierda permanece fija
     * y el scroll ocurre aquí — todas
     * las secciones de la landing page
     * se apilan y se recorren dentro
     * de este contenedor.
     */
    overflow-x: hidden;
    overflow-y: auto;

    scroll-behavior: smooth;

    /*
     * Mejora el scroll en dispositivos táctiles.
     */
    -webkit-overflow-scrolling: touch;
}


/* ============================
   PANTALLA DE BIENVENIDA
   Por defecto (y al pulsar el
   personaje/logo), solo se ve el
   panel de navegación a pantalla
   completa — igual que antes.
   Al pulsar cualquier enlace del
   menú se revela el contenido.
   Solo aplica en escritorio; en
   móvil/tablet el panel ya tiene
   su propio comportamiento de
   cajón (ver responsive más abajo).
============================ */

@media (min-width: 701px) {

    /*
     * OJO: .derecha y #content son el MISMO elemento
     * (<div class="col derecha" id="content">). Un selector
     * de id siempre gana en especificidad a uno de clase, así
     * que hay que apuntar también a #content aquí o la regla
     * de más abajo (div#content{display:block}) la anularía
     * sin importar la media query.
     */

    #content {
        display: none;
    }

    .izquierda {
        width: 100vw;
    }

    body.mostrar-contenido #content {
        display: block;
    }

    body.mostrar-contenido .izquierda {
        width: 20vw;
    }

}


/* ============================
   CONTENEDOR DE CONTENIDO
============================ */

div#content {
    width: 100%;

    min-height: 100%;

    position: relative;

    text-align: center;
}


/* ============================
   ELEMENTOS GENERALES
============================ */

* {
    box-sizing: border-box;
}


/* ============================
   ACCESIBILIDAD: solo lectores
   de pantalla (oculta visualmente
   sin quitar el elemento del
   árbol de accesibilidad)
============================ */

.sr-only {
    position: absolute;

    width: 1px;
    height: 1px;

    padding: 0;
    margin: -1px;

    overflow: hidden;

    clip: rect(0, 0, 0, 0);
    white-space: nowrap;

    border: 0;
}

@media (prefers-reduced-motion: reduce) {
    .derecha {
        scroll-behavior: auto;
    }
}


/* ============================
   SCROLL
============================ */

.derecha {
    scrollbar-width: thin;
    scrollbar-color:
        rgba(244, 227, 178, 0.45)
        rgba(0, 0, 0, 0.2);
}

.derecha::-webkit-scrollbar {
    width: 8px;
}

.derecha::-webkit-scrollbar-track {
    background:
        rgba(0, 0, 0, 0.2);
}

.derecha::-webkit-scrollbar-thumb {
    background:
        rgba(244, 227, 178, 0.4);

    border-radius: 10px;
}

.derecha::-webkit-scrollbar-thumb:hover {
    background:
        rgba(244, 227, 178, 0.65);
}


/* ============================
   RESPONSIVE
   3 escalones: tablet/portátil sin
   maximizar (700px), móvil apaisado
   (560px), móvil (480px).

   En los 3, el panel izquierdo deja de
   convivir en estrecho junto al contenido:
   se oculta siempre por defecto y solo
   aparece como overlay a pantalla completa
   al pulsar el botón de mostrar/ocultar menú.
============================ */

@media (max-width: 700px) {

    .boton-alternar-panel {
        display: none;
    }

    body.mostrar-contenido .boton-alternar-panel {
        display: flex;
    }

    /* La columna izquierda es la pantalla de bienvenida por
       defecto en móvil también: visible al cargar, se oculta
       solo cuando se muestra contenido. */
    #content {
        display: none;
    }

    .izquierda {
        position: fixed;
        inset: 0;

        width: 100%;
        height: 100%;

        z-index: 150;

        transform: translateX(0);

        transition: transform .35s ease;
    }

    body.mostrar-contenido .izquierda {
        transform: translateX(-100%);
    }

    body.mostrar-contenido #content {
        display: block;
        width: 100%;
    }

    .menu a {
        font-size: 1.4rem;
    }

    .logo {
        width: 110px;
    }

}


@media (max-width: 560px) {

    .izquierda {
        gap: 1.4rem;
    }

    .menu {
        gap: 1.1rem;
    }

    .menu a {
        font-size: 1.2rem;
    }

    .logo {
        width: 90px;
    }

    .info {
        font-size: .9rem;
    }

    .redes a {
        font-size: 1.4rem;
    }

}


@media (max-width: 480px) {

    .boton-alternar-panel {
        width: 40px;
        height: 58px;
    }

    .izquierda {
        gap: 1.1rem;
    }

    .menu {
        gap: .9rem;
    }

    .menu a {
        font-size: 1.05rem;
    }

    .logo {
        width: 72px;
    }

    .info {
        font-size: .8rem;
        margin-top: 1.2rem;
    }

    .redes {
        gap: 1rem;
    }

    .redes a {
        font-size: 1.3rem;
    }

}